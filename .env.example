# Copy to `.env` beside myfind.toml and fill in. `.env` is gitignored; this
# example is tracked so a fresh checkout knows which names to set.
#
# Every value here can also be supplied as a real environment variable, which is
# the right thing in a container or a systemd unit.

# BaseX REST credentials. The account needs READ (and, for the indexing script's
# ingest path, whatever your store requires). Do NOT reuse the built-in `admin`
# account for an application -- see the BaseX notes in AGENTS.md.
MYFIND_BASEX_PASSWORD=change-me
MYFIND_BASEX_USER=myfind

# Optional overrides (defaults shown).
# MYFIND_BASEX_URL=http://localhost:8080/rest
# MYFIND_SOLR_URL=http://localhost:8983/solr/myfind
# MYFIND_CONFIG=myfind.toml
# MYFIND_HOST=127.0.0.1
# MYFIND_PORT=5000

# An alternative file to read these from, if you keep secrets somewhere central.
# MYFIND_ENV_FILE=~/.config/myfind/secrets.env
