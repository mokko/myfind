[Unit]
Description=myfind discovery portal (ASGI: uvicorn + Starlette)
Documentation=https://github.com/mokko/myfind
After=network-online.target
Wants=network-online.target
# Ordering only, deliberately not Requires=: if BaseX or Solr is slow to come up
# the app must still start and answer 503, which is the designed behaviour.
# Requires= would take the portal down whenever a backend is being restarted.
After=basex.service solr.service

[Service]
Type=simple
User=maurice
Group=maurice
WorkingDirectory=/home/maurice/py/myfind

# The BaseX password is read from ./.env beside myfind.toml (mode 600), which the
# app already does. A root-owned central file works too -- uncomment and create
# it with `install -m 600 -o root -g root /dev/null /etc/myfind/env`:
#EnvironmentFile=/etc/myfind/env

# The ASGI server, NOT `gunicorn` (which serves WSGI) and NOT `python -m myfind.app`
# (a development entry point). gunicorn against this app fails outright: it is
# ASGI now, and gunicorn speaks WSGI.
#
# --factory because create_app() is a factory, not a module-level app object.
# --proxy-headers + --forwarded-allow-ips let uvicorn trust nginx's
# X-Forwarded-* headers, so client IPs and scheme are right behind the proxy.
#
# FEWER workers than the WSGI version needed: one event loop now holds many
# requests in flight, where before concurrency came only from processes. CPU work
# (the XML parse) is offloaded per-request via anyio.to_thread, whose default
# limiter is 40 threads.
ExecStart=/home/maurice/py/myfind/.venv/bin/uvicorn myfind.app:create_app \
    --factory \
    --host 127.0.0.1 \
    --port 8010 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1 \
    --timeout-keep-alive 15

Restart=on-failure
RestartSec=3

# Bound loopback above, so only the reverse proxy (or a VPN route) reaches it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 4 workers measure ~45 MB each (223 MB for master + workers). 1 GB is generous
# headroom; it exists so a runaway does not take the box down with it.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
